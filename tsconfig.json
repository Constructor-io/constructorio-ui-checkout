{
  "compilerOptions": {
    "target": "ES2019",
    "module": "esnext",
    "lib": ["dom", "esnext"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "noEmit": true,
    "allowJs": true,
    "types": ["vitest/globals", "node", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@spec/*": ["spec/*"],
      "@stories/*": ["stories/*"]
    }
  },
  "include": [
    "src/**/*",
    "spec/**/*",
    "stories/**/*",
    "vitest.config.ts",
    ".storybook/**/*",
    "vite.**.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
