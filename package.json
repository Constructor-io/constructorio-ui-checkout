{
  "name": "@constructor-io/constructorio-ui-checkout",
  "version": "1.2.0",
  "description": "Constructor.io Stripe Embedded Checkout UI library for web applications",
  "author": "Constructor.io Corporation",
  "license": "MIT",
  "homepage": "https://github.com/Constructor-io/constructorio-ui-checkout#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constructor-io/constructorio-ui-checkout.git"
  },
  "bugs": {
    "url": "https://github.com/Constructor-io/constructorio-ui-checkout/issues"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./styles.css": "./dist/styles.css",
    "./constructorio-ui-checkout-standalone": {
      "import": "./dist/standalone/constructorio-ui-checkout.standalone.js",
      "require": "./dist/standalone/constructorio-ui-checkout.standalone.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "dist/styles.css"
  ],
  "dependencies": {
    "use-sync-external-store": "^1.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "npm run build:lib && npm run build:standalone && npm run build:types",
    "lint": "eslint src spec stories .storybook",
    "lint:fix": "eslint src spec stories .storybook --fix",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "prepare": "husky",
    "check-license": "license-checker --production --onlyAllow 'Apache-2.0;BSD-3-Clause;MIT;0BSD;BSD-2-Clause;ISC' --excludePackages 'lightningcss@1.32.0;lightningcss-darwin-arm64@1.32.0;lightningcss-linux-x64-gnu@1.32.0;lightningcss-linux-x64-musl@1.32.0'",
    "dev": "storybook dev -p 6008",
    "build-storybook": "storybook build --docs -o 'docs'",
    "test-storybook": "vitest run --project storybook",
    "test-storybook:watch": "vitest --project storybook",
    "test-storybook:ci": "vitest run --project storybook",
    "test": "vitest --project unit",
    "test:unit": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "storybook-docs-dev": "storybook dev --docs -p 6009"
  },
  "peerDependencies": {
    "@constructor-io/constructorio-ui-components": ">=1.4.0",
    "@stripe/react-stripe-js": ">=6.6.0",
    "@stripe/stripe-js": ">=9.3.1",
    "react": ">=16.12.0",
    "react-dom": ">=16.12.0"
  },
  "overrides": {
    "@storybook/test-runner": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@constructor-io/constructorio-ui-components": "^1.4.0",
    "@cspell/eslint-plugin": "^9.6.4",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-vitest": "^9.1.20",
    "@storybook/react": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/postcss-prefix-selector": "^1.16.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/eslint-plugin": "^1.6.23",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-snapshot-testing": "^1.0.61",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "9.1.20",
    "eslint-plugin-testing-library": "^7.16.2",
    "fishery": "^2.4.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "license-checker": "^25.0.1",
    "playwright": "^1.63.0",
    "postcss-prefix-selector": "^2.1.1",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "9.1.20",
    "tslib": "^2.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.5",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^4.1.2",
    "vitest-fail-on-console": "^0.10.1"
  },
  "volta": {
    "node": "22.18.0",
    "npm": "10.9.3"
  }
}
