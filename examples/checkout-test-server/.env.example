# Copy this file to .env: `cp .env.example .env`. The defaults run the store,
# the PIA panel and the flows that need no payment keys.
# The server reads every value. The client only sees values that start with VITE_.

# Constructor index used by the store and the PIA panel.
# This is the public demo index key, safe to commit.
VITE_CIO_API_KEY=key_1tigFZoUEs7Ygkww
# Seed product id from the demo index.
VITE_SEED_ITEM_ID=68d1abed-374d-4b7b-abec-1b7d2afcedac

# Demo logins. These accounts only exist in the server's in-memory fixtures.
DEMO_USER_EMAIL=demo@constructor.io
DEMO_USER_PASSWORD=demo123
DEMO_VIP_EMAIL=vip@constructor.io
DEMO_VIP_PASSWORD=vip123
# Prefilled in the client's login form.
VITE_DEMO_EMAIL=demo@constructor.io
VITE_DEMO_PASSWORD=demo123

# Ports and URLs.
PORT=4000
CLIENT_PORT=5173
CLIENT_URL=http://localhost:5173

# Stripe test keys, from https://dashboard.stripe.com/test/apikeys
# Leave empty to run without Stripe. The Stripe flows then cannot create a session.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Square sandbox credentials, from https://developer.squareup.com/apps
# Leave empty to run without Square. The /square flow then returns 503.
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Fiserv CommerceHub (CERT). /fiserv flow. Keys from https://developer.fiserv.com
COMMERCEHUB_API_KEY=
COMMERCEHUB_API_SECRET=
COMMERCEHUB_MERCHANT_ID=
COMMERCEHUB_TERMINAL_ID=
COMMERCEHUB_BASE_URL=https://connect-cert.fiservapis.com/ch
